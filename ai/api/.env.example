GEMINI_API_KEY=your-gemini-api-key-here

# Optional: enables live web search (Google Custom Search JSON API,
# free tier, 100 queries/day, no billing required). Leave both blank
# to disable — the chat still works, just without web search.
GOOGLE_CSE_API_KEY=your-google-cloud-api-key-here
GOOGLE_CSE_ID=your-programmable-search-engine-id-here
